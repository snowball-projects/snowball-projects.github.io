---
import type { CollectionEntry } from "astro:content";
import { projectHref } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const href = projectHref(project);
const Heading = `h${headingLevel}` as "h2" | "h3";
const destination =
  project.data.category === "dashboard"
    ? "dashboard"
    : project.data.category === "developer"
      ? "GitHub repository"
      : "project";
---

<article class="project-card">
  <a
    class="project-card__link"
    href={href}
    aria-label={`${project.data.title} - open ${destination}`}
  >
    <Heading>{project.data.title}</Heading>
    <p>{project.data.summary}</p>
  </a>
</article>
