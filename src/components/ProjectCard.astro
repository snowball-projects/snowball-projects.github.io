---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { projectTopicHref, projectTopicLabels } from "../lib/project-topics";
import { projectHref } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props;
const href = projectHref(project);
const Heading = `h${headingLevel}` as "h2" | "h3";
const destination = project.data.liveUrl
  ? "live interface"
  : project.data.repository
    ? "GitHub repository"
    : "project details";
const icon = project.data.icon
  ? await getImage({
      src: project.data.icon,
      width: 40,
      height: 40,
      densities: project.data.icon.format === "svg" ? undefined : [1, 2],
      format: project.data.icon.format === "svg" ? "svg" : "webp",
    })
  : undefined;
---

<article class="project-card">
  <a
    class="project-card__link"
    href={href}
    aria-label={`${project.data.title} - open ${destination}`}
  >
    <Heading>
      {
        icon && (
          <img
            {...icon.attributes}
            class="project-card__icon"
            src={icon.src}
            srcset={icon.srcSet.attribute}
            alt=""
          />
        )
      }
      <span>{project.data.title}</span>
    </Heading>
    <p>{project.data.summary}</p>
  </a>
  <ul class="project-card__topics" aria-label={`${project.data.title} topics`}>
    {
      project.data.topics.map((topic) => (
        <li>
          <a href={projectTopicHref(topic)}>{projectTopicLabels[topic]}</a>
        </li>
      ))
    }
  </ul>
</article>
