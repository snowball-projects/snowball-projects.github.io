---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pageType?: "website" | "article";
  socialImage?: string | null;
  socialImageAlt?: string;
  mainClass?: string;
}

const {
  title,
  description,
  pageType = "website",
  socialImage = "/og.png",
  socialImageAlt = "snowball",
  mainClass,
} = Astro.props;
const pageTitle = title === "snowball" ? title : `${title} - snowball`;
const path = Astro.url.pathname;
const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site ?? Astro.url).href
  : undefined;
const navigation = [
  { href: "/writing/", label: "Blog" },
  { href: "/principles/", label: "Principles" },
];
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'none'",
  "connect-src 'none'",
  "font-src 'self'",
  "form-action 'none'",
  "frame-src 'none'",
  "img-src 'self'",
  "manifest-src 'self'",
  "media-src 'none'",
  "object-src 'none'",
  "script-src 'none'",
  "style-src 'self' 'unsafe-inline'",
  "worker-src 'none'",
].join("; ");

const isCurrent = (href: string) =>
  href === "/" ? path === href : path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content={contentSecurityPolicy}
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0e0f" />
    <meta property="og:site_name" content="snowball" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={Astro.url} />
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {
      socialImageUrl && (
        <meta property="og:image:alt" content={socialImageAlt} />
      )
    }
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {
      socialImageUrl && (
        <meta name="twitter:image:alt" content={socialImageAlt} />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="snowball blog"
      href="/rss.xml"
    />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">
        <img
          class="site-logo"
          src="/favicon.png"
          width="64"
          height="64"
          alt=""
        />
        <span>snowball</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="site-provenance">
        <a href="/licensing/#how-snowball-is-built">{"Built by AI agents"}</a>
      </p>
      <nav aria-label="Footer navigation">
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/licensing/">Licensing</a></li>
          <li><a href="https://github.com/snowball-projects">Source</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
