---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pageClass?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  mainClass={frontmatter.pageClass}
>
  <article class="prose">
    <div class="content content--page">
      <slot />
    </div>
  </article>
</BaseLayout>
