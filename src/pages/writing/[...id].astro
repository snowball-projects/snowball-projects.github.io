---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import "katex/dist/katex.min.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { assertPublishedWritingProjectReferences } from "../../lib/content-invariants";
import { projectHref } from "../../lib/projects";

export async function getStaticPaths() {
  const [allArticles, projects] = await Promise.all([
    getCollection("writing"),
    getCollection("projects"),
  ]);
  assertPublishedWritingProjectReferences(allArticles, projects);

  const articles = allArticles.filter((article) => !article.data.draft);

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"writing">;
}

const { article } = Astro.props;
const { Content } = await render(article);
const project = article.data.project
  ? await getEntry("projects", article.data.project)
  : undefined;
const authorFormatter = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
});
---

<BaseLayout
  title={article.data.title}
  description={article.data.summary}
  pageType="article"
  socialImage={null}
>
  <article class="prose">
    <h1>{article.data.title}</h1>
    <p class="article-meta">
      <time datetime={article.data.publishedDate.toISOString()}>
        {
          article.data.publishedDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            timeZone: "UTC",
          })
        }
      </time>
      {
        article.data.updatedDate && (
          <span class="article-meta__updated">
            Updated{" "}
            <time datetime={article.data.updatedDate.toISOString()}>
              {article.data.updatedDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
          </span>
        )
      }
      <span class="article-meta__authors">
        Directed by {authorFormatter.format(article.data.authors)}
      </span>
    </p>
    {
      project && (
        <p class="article-context">
          <a href={projectHref(project)}>{project.data.title}</a>
        </p>
      )
    }
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>
