---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("writing"))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  );
const authorFormatter = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
});
---

<BaseLayout
  title="Blog"
  description="Technical notes from snowball projects."
  mainClass="writing-index"
>
  <h1 class="visually-hidden">Blog</h1>

  {
    articles.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      <ol class="article-list">
        {articles.map((article) => (
          <li>
            <article>
              <h2>
                <a href={`/writing/${article.id}/`}>{article.data.title}</a>
              </h2>
              <p>{article.data.summary}</p>
              <p class="article-meta">
                <time datetime={article.data.publishedDate.toISOString()}>
                  {article.data.publishedDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
                <span class="article-meta__authors">
                  Directed by {authorFormatter.format(article.data.authors)} ·
                  Written by AI agents
                </span>
              </p>
            </article>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>
