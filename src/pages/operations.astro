---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectHref } from "../lib/projects";
import snapshotData from "../data/operations.json";
import {
  parseOperations,
  renderHoursLabel,
  metricPercent,
} from "../lib/operations";
import "../styles/operations.css";

const projects = (await getCollection("projects")).filter(
  ({ data }) => !data.draft,
);
const snapshot = parseOperations(
  snapshotData,
  projects.map(({ id }) => id),
);
const projectIndex = new Map(projects.map((project) => [project.id, project]));
const renderProjectNames = snapshot.projects
  .filter(({ hosting }) => hosting === "render-free")
  .map(({ id }) => projectIndex.get(id)!.data.title);
const renderProjectList = new Intl.ListFormat("en-US", {
  style: "long",
  type: "conjunction",
}).format(renderProjectNames);
const money = (value: number | null) =>
  value === null
    ? "Not recorded"
    : new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 2,
      }).format(value);
const period = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${snapshot.period}-01T00:00:00Z`));
const observed = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${snapshot.observedDate}T00:00:00Z`));
---

<BaseLayout
  title="Operations"
  description="snowball's service costs, funding and shared resource use."
  mainClass="operations-page"
>
  <header class="operations-intro">
    <h1>Operations</h1>
    <p>What it takes to keep snowball running.</p>
    <p class="operations-date">
      {period} · Usage and costs checked{" "}
      <time datetime={snapshot.observedDate}>{observed}</time>
    </p>
  </header>

  <dl class="operations-totals">
    <div>
      <dt>Service costs · month to date</dt>
      <dd>
        {money(snapshot.serviceCostUsd)}
        <span>USD</span>
      </dd>
    </div>
    <div>
      <dt>Funding received · month to date</dt>
      <dd>
        {money(snapshot.fundingReceivedUsd)}
        <span>USD</span>
      </dd>
    </div>
  </dl>
  <p class="operations-note">
    Free hosting and services. These totals cover running the published
    projects, excluding personal hardware, electricity and development tools.
  </p>

  <section class="operations-section" aria-labelledby="shared-resources">
    <h2 id="shared-resources">Shared resources</h2>
    <p>
      {renderProjectList} share one Render workspace. Allowances reset monthly.
    </p>
    <ul class="operations-metrics">
      {snapshot.metrics.map((metric) => {
        const percentage = metricPercent(metric.used, metric.limit);
        return (
          <li>
            <div class="operations-metric-label">
              <a href={metric.sourceUrl}>{metric.label}</a>
              <span>
                {metric.used === null
                  ? "Not recorded"
                  : metric.used.toLocaleString("en-US")}{" "}
                / {metric.limit.toLocaleString("en-US")} {metric.unit}
              </span>
            </div>
            {percentage !== null && (
              <progress
                max="100"
                value={percentage}
                aria-label={`${metric.label}: ${metric.used} of ${metric.limit} ${metric.unit}`}
              />
            )}
          </li>
        );
      })}
    </ul>
    <p class="operations-note">
      Observed in Render's billing dashboard. These are dated observations, not
      live counters. Per-project use of the free-hour pool has not been
      established.
    </p>
    <p class="operations-note">
      Free services sleep when idle and may take time to wake. Exhausting the
      shared hours suspends them until the next month. The workspace has no
      payment method; bandwidth or build overages suspend the affected service
      or builds instead of adding charges.{" "}
      <a href="https://render.com/docs/free">Provider limits</a>.
    </p>
  </section>

  <section class="operations-section" aria-labelledby="project-resources">
    <h2 id="project-resources">Projects</h2>
    <p>
      Static sites use GitHub Pages. Hosted services use Render Free. No project
      currently needs a hosted database.
    </p>
    <div class="operations-projects">
      {snapshot.projects.map((entry) => {
        const project = projectIndex.get(entry.id)!;
        return (
          <article class="operations-project" id={entry.id}>
            <div class="operations-project-heading">
              <h3>
                <a href={projectHref(project)}>{project.data.title}</a>
              </h3>
              <span>
                {money(entry.serviceCostUsd)}{" "}
                <span class="operations-note">USD</span>
              </span>
            </div>
            <p class="operations-project-host">
              {entry.hosting === "github-pages"
                ? "GitHub Pages · static site"
                : "Render Free · web service"}
            </p>
            <p class="operations-note">
              {renderHoursLabel(entry.hosting, entry.renderHours)}
            </p>
            <details>
              <summary>Resources and storage</summary>
              <p>{entry.resources}</p>
              <p>{entry.storage}</p>
            </details>
          </article>
        );
      })}
    </div>
    <p class="operations-note">
      This website also uses GitHub Pages. Free third-party APIs and map tiles
      have their own limits; a static site can still make external requests.
    </p>
  </section>

  <section
    class="operations-section operations-method"
    aria-labelledby="record-method"
  >
    <h2 id="record-method">About this record</h2>
    <p>
      {snapshot.financialSource} Service and resource facts are checked against
      the owning repositories. Figures reflect this snapshot and can change
      before the next update.
    </p>
    <p>
      The project list reflects the current catalog. Usage and cost figures
      retain the observation date above. Shared allowances are counted once.
      Unknown use is left unknown, and reported costs exclude hypothetical paid
      equivalents. The record is updated through reviewed source changes.
    </p>
    <p>
      <a href="/operations.json">Download the record</a> ·{" "}
      <a href="https://github.com/snowball-projects/snowball-projects.github.io/blob/main/src/data/operations.json">
        Source and history
      </a>
    </p>
  </section>
</BaseLayout>
