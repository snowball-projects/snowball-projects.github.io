---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectDetailPrimaryHref } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (project) => !project.data.draft,
  );

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const primaryHref = projectDetailPrimaryHref(project);
const primaryLabel = project.data.liveUrl
  ? "Open interface"
  : project.data.repository
    ? "GitHub"
    : undefined;
const relatedWriting = (await getCollection("writing"))
  .filter(
    (article) => !article.data.draft && article.data.project === project.id,
  )
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  );
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  socialImage={null}
>
  <article class="prose">
    <h1>{project.data.title}</h1>
    <p class="project-summary">{project.data.summary}</p>
    {
      primaryHref && primaryLabel && (
        <p class="project-links">
          <a href={primaryHref}>{primaryLabel}</a>
          {project.data.liveUrl && project.data.repository && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={project.data.repository}>GitHub</a>
            </>
          )}
        </p>
      )
    }

    {
      relatedWriting.length > 0 && (
        <section class="related-content" aria-labelledby="related-writing">
          <h2 id="related-writing">Related writing</h2>
          <ul>
            {relatedWriting.map((article) => (
              <li>
                <a href={`/writing/${article.id}/`}>{article.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
