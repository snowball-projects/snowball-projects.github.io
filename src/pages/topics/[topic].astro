---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  projectTopicLabels,
  projectTopicSlugs,
  projectsForTopic,
  type ProjectTopic,
} from "../../lib/project-topics";

export function getStaticPaths() {
  return projectTopicSlugs.map((topic) => ({ params: { topic } }));
}

const topic = Astro.params.topic as ProjectTopic;
const label = projectTopicLabels[topic];
const projects = projectsForTopic(await getCollection("projects"), topic);
---

<BaseLayout
  title={`${label} projects`}
  description={`${label} projects from snowball.`}
  mainClass="topic-page"
>
  <header class="topic-heading">
    <a href="/">All projects</a>
    <h1>{label}</h1>
  </header>
  <div class="project-list">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>
