{
  "name": "snowball-site",
  "version": "0.3.0",
  "private": true,
  "author": "snowball",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run check && npm run format:check",
    "verify": "npm run test && npm run check && npm run format:check && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.3",
    "katex": "^0.18.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "6.0.3"
  }
}
