{
  "name": "snowball-site",
  "version": "0.1.0",
  "private": true,
  "author": "snowball",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run check && npm run format:check",
    "verify": "npm run test && npm run check && npm run format:check && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/rss": "4.0.19",
    "astro": "7.2.6",
    "katex": "0.18.4",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
